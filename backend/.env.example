# =============================================================================
# Darukaa.Earth — Backend Environment Configuration Template
# =============================================================================

ENVIRONMENT=development
PROJECT_NAME="Darukaa.Earth API"
VERSION="0.1.0"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL + PostGIS)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=daruka_earth
# Docker Compose maps host 5433 -> container 5432
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/daruka_earth

# Security & Authentication (JWT)
JWT_SECRET=darukaa_development_secret_key_change_in_production_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (JSON array or comma-separated). Production must include the Vercel URL.
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Site AI insights (server-side only — never expose this key to the frontend)
# Groq OpenAI-compatible Chat Completions via existing httpx; no extra SDK required.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
AI_REQUEST_TIMEOUT_SECONDS=30
