# =============================================================================
# Darukaa.Earth — Environment Configuration Template
# Copy this file to .env and adjust values for your local environment.
# NEVER commit .env to version control.
# =============================================================================

# Application
ENVIRONMENT=development
PROJECT_NAME="Darukaa.Earth API"
VERSION="0.1.0"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL + PostGIS)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=daruka_earth
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/daruka_earth

# Security & Authentication (JWT)
# Generate a secure 256-bit key in production: `openssl rand -hex 32`
JWT_SECRET=darukaa_development_secret_key_change_in_production_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (JSON string or comma-separated)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Site AI insights (backend only)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
AI_REQUEST_TIMEOUT_SECONDS=30
